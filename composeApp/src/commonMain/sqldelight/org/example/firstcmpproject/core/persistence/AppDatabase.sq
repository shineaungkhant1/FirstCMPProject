import kotlin.Boolean;

CREATE TABLE  Movie(
 id INTEGER PRIMARY KEY,
 adult INTEGER AS Boolean DEFAULT 0,
 backDropPath TEXT,
 belongsToCollection TEXT,
 budget INTEGER,
 genres TEXT,
 homePage TEXT,
 imdbId TEXT,
 originalCountry TEXT,
 genreIds TEXT,
 originalLanguage TEXT,
 originalTitle TEXT,
 overview TEXT,
 popularity REAL,
 posterPath TEXT,
 productionCompanies TEXT,
 prodictionCountries TEXT,
 releaseDate TEXT,
 revenue INTEGER ,
 runtime INTEGER ,
 spokenLanguages TEXT,
 status TEXT,
 tagline TEXT,
 title TEXT,
 video INTEGER AS Boolean DEFAULT 0,
 voteAverage REAL,
 voteCount INTEGER
);


insertPartialMovie:
INSERT OR REPLACE INTO Movie(id,adult,backDropPath,genreIds, originalLanguage, originalTitle, overview,popularity,popularity,posterPath,releaseDate,title,video,voteAverage,voteCount)
VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?);

insertFullMovie:
INSERT OR REPLACE INTO
Movie(
    id,
    adult,
    backDropPath,
    belongsToCollection,
    budget,
    genres,
    homePage,
    imdbId,
    originalCountry,
    genreIds,
    originalLanguage,
    originalTitle,
    overview,
    popularity,
    posterPath,
    prodictionCountries,
    productionCompanies,
    releaseDate,
    revenue,
    runtime,
    spokenLanguages,
    status,
    tagline,
    title,
    video,
    voteAverage,
    voteCount
)
VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?);

getMovieById:
SELECT  * FROM  Movie WHERE id=?;